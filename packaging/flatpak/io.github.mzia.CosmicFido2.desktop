[Desktop Entry]
Name=COSMIC YubiKey Manager
GenericName=FIDO2 Security Key Manager
Comment=Manage YubiKey FIDO2 & Biometric authentication for Pop!_OS COSMIC
Exec=cosmic-fido2 applet
Icon=io.github.mzia.CosmicFido2
Terminal=false
Type=Application
Categories=Settings;System;Security;Utility;
Keywords=yubikey;fido2;u2f;security;biometric;cosmic;pam;greeter;
StartupNotify=true
X-CosmicApplet=true
